# docker compose settings. Copy to .env (git-ignored) and replace every value.

# Database
MYSQL_PASSWORD=change-me-lims-db-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# JWT signing key, at least 32 bytes. Generate with:  openssl rand -base64 48
LIMS_JWT_SECRET=

# Replaces the seeded 'admin' / admin123 password on first start (min 12 characters)
LIMS_BOOTSTRAP_ADMIN_PASSWORD=

# Public URL users open (CORS/WebSocket origin and the report QR verification link)
LIMS_PUBLIC_URL=http://localhost:8081
LIMS_HTTP_PORT=8081

# 'mysql,prod' for real use; 'mysql' seeds demo accounts for training
SPRING_PROFILES_ACTIVE=mysql,prod
VITE_APP_ENV=production
VITE_SHOW_DEMO_ACCOUNTS=false
