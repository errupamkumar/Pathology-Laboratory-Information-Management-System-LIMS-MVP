# Copy to .env.local (git-ignored) to override per machine.
# VITE_* values are compiled into the bundle at build time: never put secrets here.

# REST base path or absolute URL. Same-origin '/api/v1' works with the dev proxy and the nginx image.
VITE_API_BASE_URL=/api/v1

# Print-agent WebSocket. Leave empty to derive ws(s)://<current host>/ws/print-agent.
VITE_PRINT_AGENT_WS_URL=

# Environment badge shown in the navbar (hidden when 'production').
VITE_APP_ENV=dev

# Show the seeded demo accounts on the sign-in page. Must be false outside dev/training.
VITE_SHOW_DEMO_ACCOUNTS=false

# Dev server only: where /api and /ws are proxied to.
DEV_PROXY_TARGET=http://localhost:8080
